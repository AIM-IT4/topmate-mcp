# Provider
TOPMATE_PROVIDER=sandbox
TOPMATE_CREATOR_ID=demo_creator
TOPMATE_PROFILE_URL=https://topmate.io/amit_kumar_jha

# Auth: none | bearer | multi_bearer | jwt
MCP_AUTH_MODE=none

# Legacy single-account preview
MCP_BEARER_TOKEN=

# Multi-user opaque-token pilot. Store SHA-256 digests, never plaintext tokens.
MCP_TENANT_TOKENS_JSON=[]

# JWT / OIDC
MCP_JWT_SECRET=
MCP_JWKS_URL=
MCP_JWT_ISSUER=
MCP_JWT_AUDIENCE=
MCP_JWT_ALGORITHMS=
MCP_JWT_CREATOR_CLAIM=creator_id
# Optional canonical public MCP resource URL, e.g. https://mcp.example.com/mcp
MCP_RESOURCE_URL=

MCP_RATE_LIMIT_PER_MINUTE=120
MCP_MAX_CACHED_TENANTS=1000
